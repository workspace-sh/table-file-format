{
  "name": "table-file-format",
  "version": "0.1.0",
  "private": true,
  "description": "Spike for the open .table/ data-matrix file format — workspace root.",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/mobile",
    "apps/macos"
  ],
  "scripts": {
    "test": "npm run test -w @workspace/table-core",
    "test:watch": "npm run test:watch -w @workspace/table-core",
    "build": "npm run build -w @workspace/table-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @workspace/table-web",
    "build:web": "npm run build -w @workspace/table-web"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
