{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    // Typecheck workspace packages from their source, not a build that
    // may be stale after a pull (#77). Core exports a "source" condition.
    "customConditions": ["source"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
