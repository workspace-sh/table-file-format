+#if TARGET_OS_OSX // [table-file-format patch]
+// ImageIO (below) can't read SVG, so an SVG image drew nothing. NSImage
+// decodes SVG itself (an NSSVGImageRep, resolution-independent), so SVG data
+// goes to it instead. Drop this patch once react-native-macos does the same.
+static BOOL RCTDataLooksLikeSVG(NSData *data)
+{
+  NSUInteger length = MIN(data.length, (NSUInteger)1024);
+  NSString *head = [[NSString alloc] initWithBytes:data.bytes length:length encoding:NSUTF8StringEncoding];
+  return head != nil && [head rangeOfString:@"<svg" options:NSCaseInsensitiveSearch].location != NSNotFound;
+}
+#endif
+
 RCTPlatformImage *__nullable RCTDecodeImageWithData(NSData *data, CGSize destSize, CGFloat destScale, RCTResizeMode resizeMode) // [macOS]
 {
+#if TARGET_OS_OSX // [table-file-format patch]
+  if (RCTDataLooksLikeSVG(data)) {
+    return [[NSImage alloc] initWithData:data];
+  }
+#endif
   CGImageSourceRef sourceRef = CGImageSourceCreateWithData((__bridge CFDataRef)data, NULL);
   if (!sourceRef) {
     return nil;
