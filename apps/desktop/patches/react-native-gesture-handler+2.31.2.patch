diff --git a/node_modules/react-native-gesture-handler/apple/RNGestureHandler.h b/node_modules/react-native-gesture-handler/apple/RNGestureHandler.h
index 87ba86c..00a145d 100644
--- a/node_modules/react-native-gesture-handler/apple/RNGestureHandler.h
+++ b/node_modules/react-native-gesture-handler/apple/RNGestureHandler.h
@@ -7,6 +7,19 @@
 #import "RNGestureHandlerState.h"
 
 #import <Foundation/Foundation.h>
+
+#if TARGET_OS_OSX
+// [table-file-format patch] The view a gesture's absolute
+// position is counted from: the React root view the gesture's view is mounted in, which is what layout and
+// measure() count from, and is flipped like every React view. Upstream uses the window's content view,
+// which is only the same when React fills the window; beside a native sidebar or under a toolbar every
+// position is off by the root's place in the window, and with an unflipped content view (an NSSplitView,
+// say) y runs the wrong way. Defined once, in RNGestureHandler.mm, for every handler.
+#ifdef __cplusplus
+extern "C"
+#endif
+NSView *RNGHAbsoluteSpace(NSView *view);
+#endif
 #import <React/RCTConvert.h>
 
 #define VEC_LEN_SQ(pt) (pt.x * pt.x + pt.y * pt.y)
diff --git a/node_modules/react-native-gesture-handler/apple/RNGestureHandler.mm b/node_modules/react-native-gesture-handler/apple/RNGestureHandler.mm
index c4f760c..dee2553 100644
--- a/node_modules/react-native-gesture-handler/apple/RNGestureHandler.mm
+++ b/node_modules/react-native-gesture-handler/apple/RNGestureHandler.mm
@@ -15,6 +15,23 @@
 #import <React/RCTScrollViewComponentView.h>
 #else
 #import <React/RCTScrollView.h>
+
+#endif
+
+#if TARGET_OS_OSX
+// RNGHAbsoluteSpace: see RNGestureHandler.h.
+extern "C" NSView *RNGHAbsoluteSpace(NSView *view)
+{
+  // The nearest root component view: the surface views around it can sit inside a scroll view that
+  // takes the toolbar's insets, so they don't start where the root does.
+  NSView *surface = nil;
+  for (NSView *v = view; v != nil; v = v.superview) {
+    NSString *name = NSStringFromClass([v class]);
+    if ([name isEqualToString:@"RCTRootComponentView"]) return v;
+    if (surface == nil && [name containsString:@"SurfaceView"]) surface = v;
+  }
+  return surface ?: view.window.contentView;
+}
 #endif
 
 @interface UIGestureRecognizer (GestureHandler)
