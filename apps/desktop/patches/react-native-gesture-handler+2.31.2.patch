@@ -9,12 +9,33 @@
 #import "RNPanHandler.h"
 #import "RNGHStylusData.h"
 
+#if TARGET_OS_OSX
+// [table-file-format patch] The view a gesture's absolute position is counted from: the React root view
+// the gesture's view is mounted in, which is what layout and measure() count from, and is flipped like
+// every React view. Upstream uses the window's content view, which is only the same when React fills the
+// window; beside a native sidebar or under a toolbar every position is off by the root's place in the
+// window, and with an unflipped content view (an NSSplitView, say) y runs the wrong way.
+static NSView *RNGHAbsoluteSpace(NSView *view)
+{
+  NSView *root = nil;
+  for (NSView *v = view; v != nil; v = v.superview) {
+    NSString *name = NSStringFromClass([v class]);
+    if ([name containsString:@"RootComponentView"] || [name containsString:@"SurfaceView"]) {
+      root = v;
+    }
+  }
+  return root ?: view.window.contentView;
+}
+#endif
+
