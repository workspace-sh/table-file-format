{
  "expo": {
    "name": "table-mobile",
    "slug": "table-mobile",
    "scheme": "sh.workspace.table.mobile",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon/AppIcon.icon",
      "supportsTablet": true,
      "bundleIdentifier": "sh.workspace.table.mobile"
    },
    "android": {
      "package": "sh.workspace.table.mobile"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0",
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 24,
            "newArchEnabled": true
          }
        }
      ],
      "./plugins/with-pods-deployment-floor",
      "expo-sharing",
      "expo-router"
    ]
  }
}
