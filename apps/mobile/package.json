{
  "name": "@workspace/table-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "clear": "watchman watch-del-all && expo start --clear",
    "prebuild": "expo prebuild",
    "clean": "expo prebuild --clean",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:device:release": "expo run:ios --device --configuration Release",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/table-core": "*",
    "expo": "~55.0.19",
    "expo-build-properties": "~55.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-strict-dom": "0.0.55"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
