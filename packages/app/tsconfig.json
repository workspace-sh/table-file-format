{
  "compilerOptions": {
    // Typecheck workspace packages from their source, not a build that
    // may be stale after a pull (#77). Core exports a "source" condition.
    "customConditions": ["source"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // The Mac's files and SQLite (./mac-index-host) come from the Mac app
    // that uses them (optional peers); it isn't an npm workspace, so they're
    // in its own node_modules.
    "paths": {
      "@op-engineering/op-sqlite": ["../../apps/desktop/node_modules/@op-engineering/op-sqlite"],
      "react-native-file-access": ["../../apps/desktop/node_modules/react-native-file-access"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
