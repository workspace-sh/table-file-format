{
  "name": "@workspace.sh/table-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "What an app around the .table views does, on any platform: bundle keys, a viewer's arrangements, display settings, saved state, archives, and a React binding (./react).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "source": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./react": {
      "source": "./src/react.ts",
      "default": "./src/react.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=source --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@workspace.sh/table-core": "file:../core",
    "@workspace.sh/table-ui": "file:../ui"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@workspace.sh/table-fixtures": "file:../table-fixtures",
    "react": "^19.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true,
      "comment": "Only for the ./react subpath (useTableApp). The rest of table-app is renderer-free."
    }
  }
}
