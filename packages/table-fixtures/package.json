{
  "name": "@workspace.sh/table-fixtures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./native-attachments": {
      "source": "./src/nativeAttachments.ts",
      "react-native": "./src/nativeAttachments.ts",
      "default": "./src/nativeAttachments.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "node --conditions=source --import tsx scripts/generate.ts",
    "test": "node --conditions=source --import tsx scripts/generate.ts --check"
  },
  "dependencies": {
    "@workspace.sh/table-core": "file:../core"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "react-native": "0.81.5"
  },
  "peerDependencies": {
    "react-native": ">=0.81.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true,
      "comment": "Only ./native-attachments uses it, in the React Native apps."
    }
  }
