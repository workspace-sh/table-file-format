{
  "compilerOptions": {
    // Typecheck workspace packages from their source, not a build that
    // may be stale after a pull (#77). Core exports a "source" condition.
    "customConditions": ["source"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
