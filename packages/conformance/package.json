{
  "name": "@workspace.sh/table-conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenFormula conformance: public test cases written in EDN, and a runner that measures engines against them.",
  "scripts": {
    "list:functions": "node --import tsx scripts/list-openformula-functions.ts",
    "run": "node --conditions=source --disable-warning=ExperimentalWarning --import tsx src/run.ts",
    "test": "node --conditions=source --disable-warning=ExperimentalWarning --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "edn-data": "^1.2.2",
    "formualizer": "^0.9.3",
    "@workspace.sh/table-core": "*"
  }
}
