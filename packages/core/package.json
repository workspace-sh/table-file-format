{
  "name": "@workspace.sh/table-core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./parser": {
      "source": "./src/parser.ts",
      "types": "./dist/parser.d.ts",
      "default": "./dist/parser.js"
    },
    "./writer": {
      "source": "./src/writer.ts",
      "types": "./dist/writer.d.ts",
      "default": "./dist/writer.js"
    },
    "./archive": {
      "source": "./src/archive.ts",
      "types": "./dist/archive.d.ts",
      "default": "./dist/archive.js"
    },
    "./io": {
      "source": "./src/io.ts",
      "types": "./dist/io.d.ts",
      "react-native": "./src/io.ts",
      "default": "./dist/io.js"
    },
    "./node-fs": {
      "source": "./src/node-fs.ts",
      "types": "./dist/node-fs.d.ts",
      "default": "./dist/node-fs.js"
    },
    "./sqlite-node": {
      "source": "./src/sqlite-node.ts",
      "types": "./dist/sqlite-node.d.ts",
      "default": "./dist/sqlite-node.js"
    },
    "./indexer-cases": {
      "source": "./src/indexer.cases.ts",
      "types": "./dist/indexer.cases.d.ts",
      "default": "./dist/indexer.cases.js"
    },
    "./sqlite-expo": {
      "source": "./src/sqlite-expo.ts",
      "types": "./dist/sqlite-expo.d.ts",
      "default": "./dist/sqlite-expo.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch src/**/*.test.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
