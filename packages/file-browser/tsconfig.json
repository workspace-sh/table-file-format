{
  "compilerOptions": {
    // Typecheck workspace packages from their source, not a build that
    // may be stale after a pull (#77). Core exports a "source" condition.
    "customConditions": ["source"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Expo itself comes from the app that uses the bar (a peer dependency),
    // and npm keeps it in the app's own node_modules, not the root's.
    "paths": { "expo": ["../../apps/mobile/node_modules/expo"] }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
