{
  "fields": [
    { "name": "title", "type": "string", "constraints": { "required": true } },
    { "name": "status", "type": "string", "constraints": { "enum": ["planning", "active", "on-hold", "done"] } },
    { "name": "owner", "type": "string" },
    { "name": "budget", "type": "number", "format": "currency:USD" },
    { "name": "launched", "type": "date" },
    { "name": "summary", "type": "string", "format": "markdown" },
    {
      "name": "per_month",
      "title": "Budget / month",
      "type": "number",
      "computed": { "expr": "(round (/ budget 12) 0)", "dialect": "table-expr-v1" }
    }
  ],
  "primaryKey": ["title"],
  "schema-version": 1
}
