{
  "fields": [
    {
      "id": "j49tkemwbf17r",
      "name": "title",
      "type": "string",
      "title": "Deal",
      "constraints": {
        "required": true
      }
    },
    {
      "id": "mabuakau8tjug",
      "name": "company",
      "type": "string",
      "title": "Company",
      "relation": {
        "table": "companies",
        "field": "id"
      }
    },
    {
      "id": "pbpftmn36sxnq",
      "name": "contacts",
      "type": "array",
      "title": "Contacts",
      "relation": {
        "table": "contacts",
        "field": "id",
        "cardinality": "many"
      }
    },
    {
      "id": "md7yzo3kw3d81",
      "name": "stage",
      "type": "string",
      "title": "Stage",
      "constraints": {
        "enum": [
          {
            "value": "lead",
            "label": "Lead",
            "color": "gray"
          },
          {
            "value": "qualified",
            "label": "Qualified",
            "color": "blue"
          },
          {
            "value": "proposal",
            "label": "Proposal",
            "color": "purple"
          },
          {
            "value": "negotiation",
            "label": "Negotiation",
            "color": "orange"
          },
          {
            "value": "won",
            "label": "Won",
            "color": "green"
          },
          {
            "value": "lost",
            "label": "Lost",
            "color": "red"
          }
        ],
        "required": true
      }
    },
    {
      "id": "yenis3phpcrn1",
      "name": "value",
      "type": "number",
      "title": "Value",
      "format": "currency:USD",
      "align": "end"
    },
    {
      "id": "gqhzunramagty",
      "name": "probability",
      "type": "number",
      "title": "Probability",
      "format": "percent",
      "constraints": {
        "minimum": 0,
        "maximum": 1
      }
    },
    {
      "id": "x638q3pmppoye",
      "name": "weighted",
      "type": "number",
      "title": "Weighted",
      "description": "Value times probability: what the deal is worth to the forecast.",
      "computed": {
        "expr": "(round (* value probability) 0)",
        "dialect": "table-expr-v1"
      }
    },
    {
      "id": "ckjab9fcna5nf",
      "name": "open_value",
      "type": "number",
      "title": "Open value",
      "description": "The deal's value while it's still open; nothing once it's won or lost.",
      "computed": {
        "expr": "(if (or (= stage \"won\") (= stage \"lost\")) 0 value)",
        "dialect": "table-expr-v1"
      }
    },
    {
      "id": "r57wxgpofr4hg",
      "name": "close_date",
      "type": "date",
      "title": "Close date"
    },
    {
      "id": "gm95w4ffnqbgi",
      "name": "renewal",
      "type": "boolean",
      "title": "Renewal"
    },
    {
      "id": "cbs3num9xuqbe",
      "name": "industry",
      "type": "string",
      "title": "Industry",
      "description": "Looked up from the deal's company (D36).",
      "computed": {
        "expr": "(related \"company\" \"industry\")",
        "dialect": "table-expr-v1"
      }
    },
    {
      "id": "nczi59m8iph3w",
      "name": "company_pipeline",
      "type": "number",
      "title": "Company pipeline",
      "description": "The company's whole open pipeline: its rollup of every open deal, this one included (#123).",
      "format": "currency:USD",
      "computed": {
        "expr": "(related \"company\" \"open_pipeline\")",
        "dialect": "table-expr-v1"
      }
    }
  ],
  "schema-version": 1
}
