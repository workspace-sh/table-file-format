        },
        {
          "description": "a boolean as 1",
          "rule": "SPEC 9, rule 2",
          "valid": false,
          "row": {
            "id": "r1",
            "boolean": 1
          }
        },
        {
          "description": "a date with a time",
          "rule": "SPEC 2, Value encodings",
          "valid": false,
          "row": {
            "id": "r1",
            "date": "2026-04-01T00:00:00Z"
          }
        },
        {
          "description": "a date with a thirteenth month",
          "rule": "SPEC 2, Value encodings",
          "valid": false,
          "row": {
            "id": "r1",
            "date": "2026-13-01"
          }
        },
        {
          "description": "a datetime without seconds",
          "rule": "SPEC 2, Value encodings (seconds are always written)",
          "valid": false,
          "row": {
            "id": "r1",
            "datetime": "2026-04-01T09:30"
