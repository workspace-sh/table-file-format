    },
    {
      "description": "constraints",
      "schema": {
        "fields": [
          {
            "name": "title",
            "type": "string",
            "constraints": {
              "required": true,
              "minLength": 2,
              "maxLength": 5,
              "pattern": "^[A-Z]"
            }
          },
          {
            "name": "n",
            "type": "number",
            "constraints": {
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "r",
            "type": "number",
            "constraints": {
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          },
          {
            "name": "y",
            "type": "year",
            "constraints": {
              "minimum": 1900
            }
          }
        ]
      },
      "cases": [
        {
          "description": "every constraint met",
          "rule": "SPEC 9, rule 2",
          "valid": true,
          "row": {
            "id": "r1",
            "title": "Abc",
            "n": 0,
            "r": 0.5,
            "y": 1900
          }
        },
        {
          "description": "bounds include their limit",
          "rule": "SPEC 2, Field constraints",
          "valid": true,
          "row": {
            "id": "r1",
            "title": "Abc",
            "n": 100
          }
        },
        {
          "description": "a required field absent",
          "rule": "SPEC 2, Empty values",
          "valid": false,
          "row": {
            "id": "r1"
          }
        },
        {
          "description": "a required field null",
          "rule": "SPEC 2, Empty values",
          "valid": false,
          "row": {
            "id": "r1",
            "title": null
          }
        },
        {
          "description": "a required field \"\"",
          "rule": "SPEC 2, Empty values",
          "valid": false,
          "row": {
            "id": "r1",
            "title": ""
          }
        },
        {
          "description": "shorter than minLength",
          "rule": "SPEC 9, rule 2",
          "valid": false,
          "row": {
            "id": "r1",
            "title": "A"
          }
        },
        {
          "description": "longer than maxLength",
          "rule": "SPEC 9, rule 2",
          "valid": false,
          "row": {
            "id": "r1",
            "title": "Abcdef"
          }
        },
        {
          "description": "not matching the pattern",
          "rule": "SPEC 9, rule 2",
          "valid": false,
          "row": {
            "id": "r1",
            "title": "abc"
          }
        },
        {
          "description": "below the minimum",
          "rule": "SPEC 9, rule 2",
          "valid": false,
          "row": {
            "id": "r1",
            "title": "Abc",
            "n": -1
          }
        },
        {
          "description": "above the maximum",
          "rule": "SPEC 9, rule 2",
          "valid": false,
          "row": {
            "id": "r1",
            "title": "Abc",
            "n": 101
          }
        },
        {
          "description": "at the exclusive minimum",
          "rule": "SPEC 2, Field constraints",
          "valid": false,
          "row": {
            "id": "r1",
            "title": "Abc",
            "r": 0
          }
        },
        {
          "description": "at the exclusive maximum",
          "rule": "SPEC 2, Field constraints",
          "valid": false,
          "row": {
            "id": "r1",
            "title": "Abc",
            "r": 1
          }
        },
        {
          "description": "a year below its minimum",
          "rule": "SPEC 9, rule 2",
          "valid": false,
          "row": {
            "id": "r1",
            "title": "Abc",
            "y": 1899
          }
        }
      ]
    },
    {
      "description": "choices and relations",
      "schema": {
        "fields": [
          {
            "name": "status",
            "type": "string",
            "categories": [
              {
                "value": "planning",
                "color": "gray"
              },
              "done"
            ]
          },
          {
            "name": "old",
            "type": "string",
            "constraints": {
              "enum": [
                "a",
                "b"
              ]
            }
          },
          {
            "name": "tags",
            "type": "array",
            "categories": [
              "red",
              "green"
            ]
          },
          {
            "name": "must",
            "type": "array",
            "categories": [
              "x"
            ],
            "constraints": {
              "required": true
            }
          },
          {
            "name": "owner",
            "type": "string",
            "relation": {
              "table": "people",
              "field": "id"
            }
          },
          {
            "name": "deals",
            "type": "array",
            "relation": {
              "table": "deals",
              "field": "id",
              "cardinality": "many"
            }
          },
          {
            "name": "total",
            "type": "number",
            "computed": {
              "expr": "(+ 1 1)",
              "dialect": "table-expr-v1"
            }
          }
        ]
      },
      "cases": [
        {
          "description": "a choice, a multi-select and relations",
          "rule": "SPEC 2, Choices: categories",
          "valid": true,
          "row": {
            "id": "r1",
            "status": "planning",
            "old": "b",
            "tags": [
              "red",
              "green"
            ],
            "must": [
              "x"
            ],
            "owner": "p1",
            "deals": [
              "d1",
              "d2"
            ]
          }
        },
        {
          "description": "an empty multi-select where it isn't required",
          "rule": "SPEC 2, Multi-select",
          "valid": true,
          "row": {
            "id": "r1",
            "tags": [],
            "must": [
              "x"
            ]
          }
        },
        {
          "description": "a computed field's value isn't checked: writers drop it",
          "rule": "SPEC 2, Computed fields",
          "valid": true,
          "row": {
            "id": "r1",
            "must": [
              "x"
            ],
            "total": "anything"
          }
        },
        {
          "description": "a value outside the choices",
          "rule": "SPEC 2, Choices: categories",
          "valid": false,
          "row": {
            "id": "r1",
            "status": "paused",
            "must": [
              "x"
            ]
          }
        },
        {
          "description": "a value outside constraints.enum",
          "rule": "SPEC 2, Choices: categories",
          "valid": false,
          "row": {
            "id": "r1",
            "old": "c",
            "must": [
              "x"
            ]
          }
        },
        {
          "description": "a multi-select item outside the choices",
          "rule": "SPEC 2, Multi-select",
          "valid": false,
          "row": {
            "id": "r1",
            "tags": [
              "red",
              "blue"
            ],
            "must": [
              "x"
            ]
          }
        },
        {
          "description": "a required multi-select that's empty",
          "rule": "SPEC 2, Multi-select",
          "valid": false,
          "row": {
            "id": "r1",
            "must": []
          }
        },
        {
          "description": "a many relation holding one id",
          "rule": "SPEC 2, Field annotations",
          "valid": false,
          "row": {
            "id": "r1",
            "must": [
              "x"
            ],
            "deals": "d1"
          }
        },
        {
          "description": "a many relation holding numbers",
          "rule": "SPEC 2, Field annotations",
          "valid": false,
          "row": {
            "id": "r1",
            "must": [
              "x"
            ],
            "deals": [
              1,
              2
            ]
          }
        }
      ]
    }
  ]
}
