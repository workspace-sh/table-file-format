        },
        {
          "description": "a time without seconds",
          "rule": "SPEC 2, Value encodings (seconds are always written)",
          "valid": false,
          "row": {
            "id": "r1",
            "time": "09:30"
          }
        },
        {
          "description": "a time with an offset",
          "rule": "SPEC 2, Value encodings",
          "valid": false,
          "row": {
            "id": "r1",
            "time": "09:30:00Z"
          }
        },
        {
          "description": "a year as text",
          "rule": "SPEC 2, Value encodings",
          "valid": false,
          "row": {
            "id": "r1",
            "year": "2026"
