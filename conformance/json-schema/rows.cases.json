{
  "about": "Cases for rows: each table's schema.json makes a JSON Schema for its rows (rowJsonSchema in @workspace.sh/table-core), and each row is checked against it.",
  "tables": [
    {
      "description": "a field of every type",
      "schema": {
        "fields": [
          {
            "name": "string",
            "type": "string"
          },
          {
            "name": "number",
            "type": "number"
          },
          {
            "name": "integer",
            "type": "integer"
          },
          {
            "name": "boolean",
            "type": "boolean"
          },
          {
            "name": "date",
            "type": "date"
          },
          {
            "name": "datetime",
            "type": "datetime"
          },
          {
            "name": "time",
            "type": "time"
          },
          {
            "name": "year",
            "type": "year"
          },
          {
            "name": "yearmonth",
            "type": "yearmonth"
          },
          {
            "name": "array",
            "type": "array"
          },
          {
            "name": "object",
            "type": "object"
          },
          {
            "name": "duration",
            "type": "duration"
          },
          {
            "name": "geopoint",
            "type": "geopoint"
          },
          {
            "name": "geojson",
            "type": "geojson"
          },
          {
            "name": "any",
            "type": "any"
          }
        ]
      },
      "cases": [
        {
          "description": "a value of each type, as the spec's table writes it",
          "rule": "SPEC 2, Value encodings",
          "valid": true,
          "row": {
            "id": "r1",
            "string": "Workspace v1",
            "number": 4200.5,
            "integer": 42,
            "boolean": true,
            "date": "2026-04-01",
            "datetime": "2026-04-01T09:30:00Z",
            "time": "09:30:00",
            "year": 2026,
            "yearmonth": "2026-11",
            "array": [
              "a",
              1
            ],
            "object": {
              "k": "v"
            },
            "duration": "PT1H30M",
            "geopoint": [
              -0.1276,
              51.5072
            ],
            "geojson": {
              "type": "Point",
              "coordinates": [
                -0.1276,
                51.5072
              ]
            },
            "any": 42
          }
        },
        {
          "description": "every value empty: absent, null or \"\"",
          "rule": "SPEC 2, Empty values",
          "valid": true,
          "row": {
            "id": "r1",
            "string": null,
            "number": "",
            "date": null
          }
        },
        {
          "description": "an id and nothing else",
          "rule": "SPEC 9, rule 1",
          "valid": true,
          "row": {
            "id": "p1"
          }
        },
        {
          "description": "a floating datetime, with no offset",
          "rule": "SPEC 2, Value encodings",
          "valid": true,
          "row": {
            "id": "r1",
            "datetime": "2026-04-01T09:30:00"
          }
        },
        {
          "description": "a datetime with an offset and a fraction",
          "rule": "SPEC 2, Value encodings",
          "valid": true,
          "row": {
            "id": "r1",
            "datetime": "2026-04-01T09:30:00.250+02:00"
          }
        },
        {
          "description": "a date in the year 0",
          "rule": "SPEC 2, Value encodings (D42)",
          "valid": true,
          "row": {
            "id": "r1",
            "date": "0000-01-01"
          }
        },
        {
          "description": "a duration in days",
          "rule": "SPEC 2, Value encodings",
          "valid": true,
          "row": {
            "id": "r1",
            "duration": "P3D"
          }
        },
        {
          "description": "a time with a fraction of a second",
          "rule": "SPEC 2, Value encodings",
          "valid": true,
          "row": {
            "id": "r1",
            "time": "09:30:00.5"
          }
        },
        {
          "description": "any: text in one row",
          "rule": "SPEC 2, Value encodings (D56)",
          "valid": true,
          "row": {
            "id": "r1",
            "any": "n/a"
          }
        },
        {
          "description": "a key the schema doesn't name",
          "rule": "SPEC 3",
          "valid": true,
          "row": {
            "id": "r1",
            "extra": 1
          }
        },
        {
          "description": "no id",
          "rule": "SPEC 9, rule 1",
          "valid": false,
          "row": {
            "string": "a"
          }
        },
        {
          "description": "an empty id",
          "rule": "SPEC 9, rule 1",
          "valid": false,
          "row": {
            "id": ""
          }
        },
        {
          "description": "an id that isn't text",
          "rule": "SPEC 9, rule 1",
          "valid": false,
          "row": {
            "id": 7
          }
        },
        {
          "description": "text in a number field",
          "rule": "SPEC 9, rule 2",
          "valid": false,
          "row": {
            "id": "r1",
            "number": "4200"
          }
        },
        {
          "description": "a fraction in an integer field",
